@model Category

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-secondary">Delete Category</h2>
            <hr />
        </div>
        <div asp-validation-summary="All" class="text-danger">
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="text-secondary"></label>
            <input asp-for="Name" disabled class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryOrder" class="text-secondary"></label>
            <input asp-for="CategoryOrder" disabled class="form-control" />
            <span asp-validation-for="CategoryOrder" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Category" asp-action="Index" class="btn btn-secondary">Back To List</a>
    </div>
</form>